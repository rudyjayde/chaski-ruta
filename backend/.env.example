# Conexion a tu PostgreSQL local (pgAdmin) o de produccion.
# Formato: postgresql://usuario:password@host:puerto/nombre_basededatos
DATABASE_URL="postgresql://postgres:TU_PASSWORD@localhost:5432/chaski_ruta"

# Credenciales OAuth de Google (Google Cloud Console -> APIs y servicios -> Credenciales)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Secreto para firmar los JWT de sesion. Genera uno largo y aleatorio, nunca lo subas a git.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# URL del frontend, para redirigir despues del login y para CORS
FRONTEND_URL=http://localhost:8443

PORT=3000

# SOLO desarrollo: ver backend/src/auth/auth.controller.ts (dev-login). Deja
# ALLOW_DEV_LOGIN sin definir (o en false) en cualquier entorno real.
ALLOW_DEV_LOGIN=false
DEV_LOGIN_SECRET=

# Cloudinary: subida real de imagenes (logos, QR de billeteras, etc.)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Asistente conversacional ("{Asociacion} AI", docs/planes/plan-pro.md #6) y
# funciones de IA aplicada (docs/planes/ia-aplicada.md, p. ej. digitalizacion
# de manifiestos con vision): API key de Claude (console.anthropic.com -> API
# Keys). Siempre SUGIERE/RESUME -- nunca decide ni guarda nada por su cuenta,
# ver ia-aplicada.md §1.
ANTHROPIC_API_KEY=
# Opcional -- id del modelo de Claude para vision/resumenes/triaje (ver
# backend/src/ai/anthropic.service.ts). Si no se define, usa un valor por
# defecto ya fijado en el codigo (hoy Sonnet, por precision en lectura de
# fotos y calculo de resumenes).
ANTHROPIC_MODEL=
# Opcional -- id del modelo para el asistente conversacional "{Asociacion} AI"
# (ver backend/src/assistant/assistant.service.ts). Por defecto usa Haiku --
# es mas barato, y este asistente solo responde preguntas puntuales de
# lookup contra datos reales, no necesita el modelo mas caro.
ASSISTANT_MODEL=

# GPS PRO / GPS Vehicular (docs/planes/plan-gps-vehicular.md): servidor Traccar
# que recibe la telemetria real de los dispositivos Teltonika instalados en las
# unidades. TRACCAR_API_URL sin barra final, ej. https://traccar.tudominio.com
# (o http://IP:8082). TRACCAR_EMAIL/TRACCAR_PASSWORD: una cuenta de Traccar con
# permiso de lectura sobre los dispositivos -- el backend se autentica con Basic
# Auth en cada llamada a la API de Traccar (sin manejo de sesion/cookies).
TRACCAR_API_URL=
TRACCAR_EMAIL=
TRACCAR_PASSWORD=
