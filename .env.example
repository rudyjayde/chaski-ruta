# Clave de la API de Google Maps (JavaScript API) usada por el mini-mapa de
# ubicación en vivo del conductor (perfil > Mi ubicación).
# Crear en https://console.cloud.google.com/google/maps-apis
# No subir el .env real con la clave real al repositorio.
VITE_GOOGLE_MAPS_API_KEY=

# URL base del backend real (NestJS) — usada para el login con Google y,
# más adelante, para todo el resto de la API. En desarrollo local coincide
# con PORT en backend/.env (por defecto http://localhost:8006).
VITE_API_URL=http://localhost:8006
